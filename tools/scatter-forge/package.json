{
  "name": "@rewild/scatter-forge",
  "version": "0.1.0",
  "description": "Procedural scatter assets for the Understory scatter system: trees, clumps and the registry entries they are declared through",
  "private": true,
  "type": "module",
  "bin": {
    "scatter-forge": "./cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --import ./test-globals.ts --test \"*.spec.ts\"",
    "test:fast": "node --import ./test-globals.ts --test scatter-forge.spec.ts sources.spec.ts",
    "test:textures": "node --import ./test-globals.ts --test textures.spec.ts",
    "ts-check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "expect": "^29.5.0",
    "sharp": "^0.35.3"
  }
}
