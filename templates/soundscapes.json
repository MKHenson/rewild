{
  "*": {
    "layers": [
      {
        "id": "gulls",
        "sound": "beach-gulls",
        "tags": ["wildlife", "birds", "far"],
        "when": { "shore": [0, 0.5], "sun": [-0.1, 0.2] }
      }
    ],
    "rules": [
      {
        "id": "rain-quiets-wildlife",
        "when": { "rain": [0.1, 0.5] },
        "scale": "#wildlife",
        "by": 0.2
      },
      {
        "id": "gale-quiets-wildlife",
        "when": { "windiness": [0.7, 1.0] },
        "scale": "#wildlife",
        "by": 0.3
      },
      {
        "id": "storm-silences-wildlife",
        "when": { "state": "Storm" },
        "scale": "#wildlife",
        "by": 0
      },
      {
        "id": "birds-after-rain",
        "when": { "state": "Clearing" },
        "scale": "#birds",
        "by": 1.3
      },
      {
        "id": "dawn-chorus",
        "when": { "dawn": [0, 1] },
        "scale": "#birds",
        "by": 1.6
      },
      {
        "id": "snow-dampens",
        "when": { "snow": [0.2, 0.8] },
        "muffle": "*",
        "cutoff": 2500
      },
      {
        "id": "fog-dulls",
        "when": { "fog": [0.4, 1.0] },
        "muffle": "#far",
        "cutoff": 4000
      }
    ]
  },
  "forest": {
    "layers": [
      { "id": "leaves", "sound": "forest-leaves-calm" },
      {
        "id": "birds",
        "sound": "forest-birds-day",
        "tags": ["wildlife", "birds", "far"],
        "when": { "sun": [-0.1, 0.2] }
      },
      {
        "id": "night",
        "sound": "forest-night",
        "tags": ["wildlife", "far"],
        "when": { "sun": [0.1, -0.2] }
      }
    ],
    "rules": [
      {
        "id": "gale-leaves",
        "when": { "windiness": [0.4, 0.8] },
        "replace": "leaves",
        "with": "forest-leaves-gale"
      },
      {
        "id": "creak",
        "when": { "windiness": [0.6, 1.0] },
        "add": "forest-creak"
      },
      {
        "id": "canopy-rain",
        "when": { "rain": [0.05, 0.4] },
        "add": "forest-canopy-rain"
      }
    ]
  },
  "plain": {
    "layers": [
      { "id": "grass", "sound": "plain-grass-calm" },
      {
        "id": "birds",
        "sound": "plain-birds",
        "tags": ["wildlife", "birds", "far"],
        "when": { "sun": [-0.1, 0.2] }
      },
      {
        "id": "crickets",
        "sound": "plain-crickets",
        "tags": ["wildlife"],
        "when": { "sun": [0.1, -0.2] }
      }
    ],
    "rules": [
      {
        "id": "wind-grass",
        "when": { "windiness": [0.4, 0.8] },
        "replace": "grass",
        "with": "plain-grass-wind"
      }
    ]
  },
  "mountain": {
    "reverb": 1,
    "layers": [
      { "id": "air", "sound": "mountain-air" },
      {
        "id": "birds",
        "sound": "mountain-birds",
        "tags": ["wildlife", "birds", "far"],
        "when": { "sun": [-0.1, 0.2] }
      }
    ],
    "rules": [
      {
        "id": "ridge-whistle",
        "when": { "windiness": [0.5, 0.9] },
        "add": "mountain-whistle"
      }
    ]
  },
  "palm-forest": {
    "without": ["gale-quiets-wildlife"],
    "layers": [
      {
        "id": "cicadas",
        "sound": "desert-cicadas",
        "tags": ["wildlife"],
        "when": { "sun": [-0.1, 0.2] }
      },
      {
        "id": "night",
        "sound": "desert-night",
        "tags": ["wildlife", "far"],
        "when": { "sun": [0.1, -0.2] }
      }
    ],
    "rules": [
      {
        "id": "blowing-sand",
        "when": { "windiness": [0.4, 0.8] },
        "add": "desert-sand"
      }
    ]
  },
  "desert-mountain": {
    "reverb": 0.8,
    "layers": [{ "id": "air", "sound": "desert-mountain-air" }],
    "rules": [
      {
        "id": "ridge-whistle",
        "when": { "windiness": [0.5, 0.9] },
        "add": "mountain-whistle"
      }
    ]
  },
  "dunes": {
    "without": ["gulls"],
    "layers": [
      { "id": "air", "sound": "desert-air", "gain": 0.5 },
      {
        "id": "night",
        "sound": "desert-night",
        "tags": ["wildlife", "far"],
        "when": { "sun": [0.1, -0.2] }
      }
    ],
    "rules": [
      {
        "id": "blowing-sand",
        "when": { "windiness": [0.4, 0.8] },
        "add": "desert-sand"
      }
    ]
  }
}
